# Copia este archivo como .env.local y completa los valores.
# Si los dejas vacios, la app funciona en modo demo y guarda los datos solo en el navegador.

# Entra ID: Id. de directorio (inquilino) y Id. de aplicacion (cliente) de la app registrada
VITE_TENANT_ID=
VITE_CLIENT_ID=

# Sitio de SharePoint donde estan las listas, por ejemplo tuempresa.sharepoint.com:/sites/Produccion
VITE_SHAREPOINT_SITE=
